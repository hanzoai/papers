% hanzo-defense.sty — Black coversheet, monochrome defense white paper style
% Hanzo Industries / Lux Industries / Zoo Labs Foundation
% 2026

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hanzo-defense}[2026/01/10 Hanzo Defense White Paper Style]

% ============================================================================
% Core packages
% ============================================================================
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{graphicx}
\RequirePackage{algorithm}
\RequirePackage{algpseudocode}
\RequirePackage{booktabs}
\RequirePackage{listings}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{subcaption}
\RequirePackage{fancyhdr}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{microtype}
\RequirePackage{float}
\RequirePackage{mathtools}
\RequirePackage[margin=1in,headheight=35pt]{geometry}
\RequirePackage[hidelinks]{hyperref}

% ============================================================================
% TikZ libraries
% ============================================================================
\usetikzlibrary{
  arrows.meta,
  positioning,
  shapes.geometric,
  fit,
  calc,
  backgrounds,
  decorations.markings
}

% ============================================================================
% Monochrome palette — no color anywhere
% ============================================================================
\definecolor{black}{RGB}{0,0,0}
\definecolor{white}{RGB}{255,255,255}
\definecolor{darkgray}{RGB}{40,40,40}
\definecolor{medgray}{RGB}{100,100,100}
\definecolor{lightgray}{RGB}{200,200,200}
\definecolor{codebg}{RGB}{245,245,245}
\definecolor{rulegray}{RGB}{80,80,80}

% All hyperlinks invisible (monochrome)
\hypersetup{
  colorlinks=false,
  pdfborder={0 0 0},
  linkcolor=black,
  citecolor=black,
  urlcolor=black
}

% ============================================================================
% Code listings — monochrome
% ============================================================================
\lstset{
  basicstyle=\ttfamily\small,
  breaklines=true,
  frame=single,
  rulecolor=\color{rulegray},
  backgroundcolor=\color{codebg},
  keywordstyle=\bfseries,
  commentstyle=\itshape\color{medgray},
  stringstyle=\color{darkgray},
  numbers=left,
  numberstyle=\tiny\color{medgray},
  numbersep=5pt,
  showstringspaces=false,
  tabsize=2
}

% ============================================================================
% Theorem environments
% ============================================================================
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{protocol}[theorem]{Protocol}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

% ============================================================================
% Headers and footers
% ============================================================================
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textit{\@hanzodoctitle}}
\fancyhead[R]{\small\thepage}
\fancyfoot[C]{\small\textsc{Hanzo Industries}\quad\textbar\quad papers.hanzo.ai}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.2pt}

% ============================================================================
% Document metadata commands
% ============================================================================
\newcommand{\@hanzodoctitle}{}
\newcommand{\@hanzodocid}{}
\newcommand{\@hanzodocversion}{}
\newcommand{\@hanzodocdate}{}
\newcommand{\@hanzodocclass}{APPROVED FOR PUBLIC RELEASE}
\newcommand{\@hanzodocauthors}{}
\newcommand{\@hanzodocorgs}{}
\newcommand{\@hanzodocabstract}{}

\newcommand{\doctitle}[1]{\renewcommand{\@hanzodoctitle}{#1}}
\newcommand{\docid}[1]{\renewcommand{\@hanzodocid}{#1}}
\newcommand{\docversion}[1]{\renewcommand{\@hanzodocversion}{#1}}
\newcommand{\docdate}[1]{\renewcommand{\@hanzodocdate}{#1}}
\newcommand{\docclass}[1]{\renewcommand{\@hanzodocclass}{#1}}
\newcommand{\docauthors}[1]{\renewcommand{\@hanzodocauthors}{#1}}
\newcommand{\docorgs}[1]{\renewcommand{\@hanzodocorgs}{#1}}
\newcommand{\docabstract}[1]{\renewcommand{\@hanzodocabstract}{#1}}

% ============================================================================
% Black coversheet
% ============================================================================
% Minimal Eames-style coversheet: H logo top-left, centered title, quiet footers.
\newcommand{\makecover}{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    % Full black background
    \fill[black] (current page.south west) rectangle (current page.north east);
    %
    % H logo — top left
    \node[anchor=north west] at ([xshift=1.4cm,yshift=-1.4cm]current page.north west)
      {\IfFileExists{hanzo-logo-white.pdf}%
        {\includegraphics[height=0.95cm]{hanzo-logo-white.pdf}}%
        {\sffamily\bfseries\large\color{white}H}};
    %
    % Document ID — top right, subtle
    \node[white!30,font=\scriptsize\ttfamily,anchor=north east]
      at ([xshift=-1.4cm,yshift=-1.65cm]current page.north east) {\@hanzodocid};
    %
    % Title — centered, no hyphenation
    \node[white,font=\fontsize{19}{24}\selectfont\bfseries\sffamily,text width=13.5cm,align=center]
      at ([yshift=1.3cm]current page.center)
      {\hyphenpenalty=10000\exhyphenpenalty=10000\@hanzodoctitle};
    %
    % Thin rule below title
    \draw[white!22,line width=0.3pt]
      ([yshift=-1.2cm,xshift=-3.5cm]current page.center) --
      ([yshift=-1.2cm,xshift=3.5cm]current page.center);
    %
    % Authors
    \node[white!50,font=\fontsize{9}{12}\selectfont\sffamily]
      at ([yshift=-2.0cm]current page.center) {\@hanzodocauthors};
    %
    % Version + date
    \node[white!28,font=\fontsize{8}{11}\selectfont\sffamily]
      at ([yshift=-2.7cm]current page.center) {\@hanzodocversion\quad\@hanzodocdate};
    %
    % Footer left — brand
    \node[white!20,font=\fontsize{6.5}{8}\selectfont\sffamily,anchor=south west]
      at ([xshift=1.4cm,yshift=1.1cm]current page.south west) {Hanzo Industries};
    %
    % Footer center — public-release marker, quiet
    \node[white!14,font=\fontsize{6.5}{8}\selectfont\sffamily,anchor=south]
      at ([yshift=1.1cm]current page.south) {Approved for public release};
    %
    % Footer right — suite pointer
    \node[white!20,font=\fontsize{6.5}{8}\selectfont\sffamily,anchor=south east]
      at ([xshift=-1.4cm,yshift=1.1cm]current page.south east) {papers.hanzo.ai};
  \end{tikzpicture}%
  \newpage
}

% ============================================================================
% Section styling — monochrome, clean
% ============================================================================
\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-3.5ex \@plus -1ex \@minus -.2ex}%
  {2.3ex \@plus.2ex}%
  {\normalfont\Large\bfseries\sffamily}}
\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\large\bfseries\sffamily}}
\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-3.25ex\@plus -1ex \@minus -.2ex}%
  {1.5ex \@plus .2ex}%
  {\normalfont\normalsize\bfseries\sffamily}}

